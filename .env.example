# Copy to .env and fill values. Never commit .env.

# --- Flouci (mobile coin top-up, hosted checkout) ---
# Dashboard → application → jeton public + jeton privé (test or prod).
FLOUCI_APP_PUBLIC_KEY=
FLOUCI_APP_SECRET=
# Same as above (optional aliases, if you prefer Flouci naming):
# FLOUCI_PUBLIC_KEY=
# FLOUCI_PRIVATE_KEY=
# FLOUCI_PRIVATE_TOKEN=

# Protects POST /api/payments/flouci/webhook (query ?token=... or header x-flouci-webhook-token)
FLOUCI_WEBHOOK_SECRET=

# Public HTTPS origin of THIS API (no trailing /api). Used for success_link, fail_link, webhook in generate_payment.
# Required for real webhooks: use ngrok/Cloudflare Tunnel in dev, real domain in prod.
# Example: PUBLIC_API_BASE_URL=https://your-subdomain.ngrok-free.app
PUBLIC_API_BASE_URL=

# Optional overrides (defaults hit Flouci production API + backend landing pages)
# FLOUCI_GENERATE_URL=https://developers.flouci.com/api/v2/generate_payment
# FLOUCI_VERIFY_ROOT=https://developers.flouci.com/api/v2/verify_payment
# FLOUCI_SUCCESS_URL=https://your-api.example.com/api/payments/flouci/landing/success
# FLOUCI_FAIL_URL=https://your-api.example.com/api/payments/flouci/landing/failure
# FLOUCI_WEBHOOK_URL=https://your-api.example.com/api/payments/flouci/webhook

# Optional coin purchase limits (defaults: 50–50000, step 50)
# COIN_TOPUP_MIN_COINS=50
# COIN_TOPUP_MAX_COINS=50000
# COIN_TOPUP_STEP_COINS=50
