// prisma/schema.prisma
// Complete schema for On-Demand Delivery Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CUSTOMER
  DRIVER
}

enum UserGender {
  MALE
  FEMALE
}

enum PasswordResetChannel {
  EMAIL
  WHATSAPP
}

enum SuperUserRole {
  ADMIN
  CUSTOMER_SERVICE
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CustomerStatus {
  CREATED
  VERIFIED
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum DriverStatus {
  INCOMPLETE
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  PAUSED
}

enum OrderStatus {
  DRAFT
  /// Customer chose a future time — drivers do not see the order until publish.
  PENDING_PUBLISH
  SEARCHING_DRIVER
  PENDING_CUSTOMER_APPROVAL
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  PICKED_UP
  DELIVERING
  RETURNED
  RETURN_DEPOSIT
  DELIVERED
  AUTO_CANCELLED
  CANCELLED
  REFUNDED
  FAILED
  DISPUTED
}

enum PaymentType {
  COD
  WALLET
}

enum OrderSourceType {
  NORMAL_CUSTOMER
  DELIVERY_COMPANY
}

enum DeliveryCompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DeliveryCompanyApiKeyStatus {
  ACTIVE
  REVOKED
}

enum DeliveryCompanyRefundDestinationType {
  BANK_TRANSFER
  CARD_REFUND
}

enum DeliveryCompanyRefundStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  FAILED
}

enum DeliveryCompanyTransactionType {
  ORDER_PAYMENT
  RETURN_SURCHARGE
  REFUND_REQUEST
  REFUND_REVERSED
  ADMIN_ADJUSTMENT
  DEPARTMENT_BUDGET_ALLOC
  DEPARTMENT_BUDGET_RETURN
}

enum DeliveryCompanyDepartmentAccountRole {
  MAIN_ADMIN
  DEPT_ADMIN
  DEPT_OPERATOR
  DEPT_VIEWER
}

enum DeliveryCompanyDepartmentAccountStatus {
  ACTIVE
  SUSPENDED
}

enum DeliveryCompanyScheduledBudgetCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum DeliveryCompanyBudgetRequestPriority {
  NORMAL
  URGENT
}

enum DeliveryCompanyBudgetRequestStatus {
  PENDING
  AUTO_APPROVED
  APPROVED
  REJECTED
  CANCELLED
}

enum DriverTransactionType {
  PLATFORM_FEE
  WITHDRAWAL
  BONUS
  PENALTY
  ADJUSTMENT
  REFUND
  DISPUTE_DEBIT
  DEPOSIT
  COIN_TRANSFER_SENT
  COIN_TRANSFER_RECEIVED
  GAME_PRIZE
}

enum WalletTransactionType {
  TOP_UP
  ORDER_PAYMENT
  REFUND
  WITHDRAWAL_REQUEST
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  BONUS
  REFERRAL_REWARD
  ADJUSTMENT
  COIN_TRANSFER_SENT
  COIN_TRANSFER_RECEIVED
  GAME_PRIZE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReferenceType {
  STRIPE_TOPUP
  FLOUCI_TOPUP
  ORDER
  REFERRAL
  WITHDRAWAL
  GAME_PRIZE
  ADMIN_ADJUSTMENT
  COIN_TRANSFER
}

enum CoinTopupSessionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CoinTopupPayerRole {
  CUSTOMER
  DRIVER
}

enum CoinTransferStatus {
  SCHEDULED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ResponseType {
  PENDING
  ACCEPTED
  REJECTED
  ON_REVIEW
}

enum DocumentType {
  PASSPORT
  ID_CARD
  STUDENT_CARD
  DRIVER_CARD
}

enum VerificationStatus {
  INCOMPLETE
  SUBMITTED
  VERIFIED
  REJECTED
}

enum RestrictionType {
  SUSPENSION
  BLOCK
  WARNING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ReferralCodeType {
  FIXED
  PERCENTAGE
}

enum ReferralCommissionStatus {
  PENDING
  PAID
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  ORDER_ISSUE
  PAYMENT
  TECHNICAL
  OTHER
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ChatStatus {
  ACTIVE
  CLOSED
}

enum MessageSenderType {
  CUSTOMER
  DRIVER
  SYSTEM
}

enum NotificationType {
  // Customer - Order Lifecycle
  ORDER_CREATED
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  PACKAGE_PICKED_UP
  DELIVERY_IN_PROGRESS
  ORDER_DELIVERED
  ORDER_CANCELLED
  NO_DRIVER_FOUND
  // Customer - Payment & Wallet
  WALLET_TOPUP_SUCCESS
  WALLET_TOPUP_FAILED
  LOW_WALLET_BALANCE
  ORDER_PAYMENT_DEDUCTED
  REFUND_PROCESSED
  WITHDRAWAL_STATUS
  COIN_TRANSFER_RECEIVED
  COIN_TRANSFER_OUTBOUND_COMPLETED
  COIN_TRANSFER_CANCELLED
  // Customer - Referral
  REFERRAL_BONUS
  REFERRED_FRIEND_REGISTERED
  // Customer - Account
  ACCOUNT_CREATED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  // Customer - Support
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  SUPPORT_TICKET_REPLY
  // Customer - Chat
  NEW_MESSAGE_FROM_DRIVER
  // Driver - Order Opportunities
  NEW_ORDER_AVAILABLE
  ORDER_EXPIRED
  // Driver - Active Order
  ORDER_CANCELLED_BY_CUSTOMER
  PICKUP_REMINDER
  // Driver - Account
  DOCUMENTS_SUBMITTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  DRIVER_ACCOUNT_SUSPENDED
  // Driver - Financial
  PAYMENT_RECEIVED_COD
  PAYMENT_CREDITED_WALLET
  NEGATIVE_BALANCE_WARNING
  ACCOUNT_BLOCKED_DEBT
  WITHDRAWAL_PROCESSED
  // Driver - Performance
  CUSTOMER_RATED_YOU
  PERFORMANCE_MILESTONE
  // Driver - Chat
  NEW_MESSAGE_FROM_CUSTOMER
  // Admin - Driver Management
  NEW_DRIVER_REGISTRATION
  DRIVER_DOCUMENTS_SUBMITTED
  DRIVER_PERFORMANCE_ALERT
  DRIVER_DEBT_THRESHOLD
  // Admin - Order Management
  ORDER_STUCK_NO_DRIVER
  HIGH_VALUE_ORDER
  ORDER_CANCELLED_AFTER_ASSIGNMENT
  // Admin - Disputes
  NEW_DISPUTE_CREATED
  DISPUTE_ESCALATED
  // Admin - Financial
  LARGE_WITHDRAWAL_REQUEST
  PAYMENT_GATEWAY_FAILURE
  DAILY_REVENUE_REPORT
  // Admin - System Health
  SERVER_ERROR_SPIKE
  DATABASE_PERFORMANCE_ALERT
  // Admin - User Management
  SUSPICIOUS_ACTIVITY
  BULK_REGISTRATION_DETECTED
  // CS - Support
  NEW_SUPPORT_TICKET
  TICKET_ASSIGNED
  CUSTOMER_REPLIED_TICKET
  URGENT_TICKET_UNRESOLVED
  SUPPORT_HUMAN_REQUESTED
  // CS - Disputes
  DISPUTE_ASSIGNED
  DISPUTE_REQUIRES_DECISION
  // CS - Order Monitoring
  DELAYED_ORDER_ALERT
  NEW_ORDER_FOR_CUSTOMER_SERVICE
  CUSTOMER_REJECTED_ARRIVED_DRIVER_CS
  CUSTOMER_REJECTED_ARRIVED_DRIVER_TO_DRIVER
  ARRIVAL_CONFLICT_DRIVER_FEEDBACK_CS
  // Games
  GAME_WINNER
  GAME_DRAW_COMPLETED
  GAME_REMINDER
}

enum NotificationPriority {
  LOW       // Informational only
  MEDIUM    // Standard notification
  HIGH      // Important, requires attention
  CRITICAL  // Urgent, requires immediate action
}

enum NotificationChannel {
  PUSH         // Mobile push notification
  IN_APP       // In-app notification center
  EMAIL        // Email notification
  SMS          // SMS (critical only)
  WEB_SOCKET   // Real-time browser notification
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum AvailabilityStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryZoneType {
  SAME_DELEGATION
  SAME_GOVERNORATE
  DIFFERENT_GOVERNORATE
  DIFFERENT_COUNTRY
}

enum OrderDriverArrivalConflictStatus {
  PENDING
  RESOLVED_FORGIVE
  RESOLVED_SUSPEND_CUSTOMER
  RESOLVED_SUSPEND_DRIVER
}

enum CustomerServiceRole {
  READ_DRIVER_PROFILE
  READ_CUSTOMER_PROFILE
  UPDATE_DRIVER_STATUS
  UPDATE_CUSTOMER_STATUS
  VERIFY_ACCOUNTS
  ACCEPT_LOCAL_PAYMENT
  VIEW_DELIVERIES
  SEE_DELIVERY_COMPANY
  MANAGE_DELIVERY_COMPANY
  MANAGE_DISPUTES
  MANAGE_SUPPORT_TICKETS
  VIEW_FINANCIAL_REPORTS
  MANAGE_FINANCIAL_REPORTS
  PROCESS_WITHDRAWALS
  MANAGE_COMPANY_FINANCE
}

enum FiatPayoutMethod {
  CASH
  BANK_TRANSFER
}

// ============================================
// CORE USER ENTITIES
// ============================================

model User {
  id          String      @id @default(uuid())
  phone       String?      @unique
  password    String?     // Optional: for email/password login (nullable for OTP-only users)
  firstName   String?     @map("first_name")
  secondName  String?     @map("second_name")
  image       String?
  myEmail     String?     @map("my_email")
  userGender  UserGender? @map("user_gender")
  googleId    String?     @unique @map("google_id") // Google's unique user ID
  googleEmail String?     @unique @map("google_email") // Email from Google
  role        UserRole
  fcmToken    String?     @map("fcm_token")
  fcmPlatform String?     @map("fcm_platform") // 'android' or 'ios'
  /// Optional identity / security verification doc (e.g. base64 image) — Settings → Security
  securityVerificationDocument    String?   @map("security_verification_document") @db.Text
  securityVerificationSubmittedAt DateTime? @map("security_verification_submitted_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  addresses        Address[]
  customer         Customer?
  driver           Driver?
  userRestrictions UserRestriction[]
  sentMessages     Message[]
  supportTickets   SupportTicket[]
  passwordResetSessions PasswordResetSession[]
  payoutBankDetails    UserPayoutBankDetails?
  transferPin            UserTransferPin?
  transferStepUpChallenges TransferStepUpChallenge[]
  coinTransfersSent      CoinTransfer[] @relation("CoinTransferSender")
  coinTransfersReceived   CoinTransfer[] @relation("CoinTransferRecipient")
  coinTopupSessions      CoinTopupSession[]

  @@map("users")
}

model UserPayoutBankDetails {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  accountHolderName String   @map("account_holder_name")
  bankName          String   @map("bank_name")
  accountReference  String   @map("account_reference")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_payout_bank_details")
}

model PasswordResetSession {
  id         String               @id @default(uuid())
  userId     String               @map("user_id")
  channel    PasswordResetChannel
  codeHash   String               @map("code_hash")
  expiresAt  DateTime             @map("expires_at")
  attempts   Int                  @default(0)
  lastSentAt DateTime             @map("last_sent_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_sessions")
}

model SuperUser {
  id            String        @id @default(uuid())
  telephone     String        @unique
  pseudo        String        @unique
  email         String        @unique
  superPassword String        @map("super_password") // Hashed password for admin/CS login
  role          SuperUserRole
  status        UserStatus    @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  fcmToken      String?       @map("fcm_token")
  fcmPlatform   String?       @map("fcm_platform")

  // Relations
  admin           Admin?
  customerService CustomerService?
  actionLogs      ActionLog[]

  @@map("super_users")
}

// ============================================
// USER TYPES
// ============================================

model Customer {
  id               String         @id @default(uuid())
  userId           String         @unique @map("user_id")
  completedOrders  Int            @default(0) @map("completed_orders")
  customerStatus   CustomerStatus @default(CREATED) @map("customer_status")
  referredByCodeId String?        @map("referred_by_code_id")
  termsAcceptedAt            DateTime? @map("terms_accepted_at")
  notifyReferralCommission   Boolean   @default(true) @map("notify_referral_commission")
  notifyGameEvents           Boolean   @default(false) @map("notify_game_events")

  // Relations
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  myReferralCode            ReferralCode?        @relation("CustomerOwnedCode")
  referredByCode            ReferralCode?        @relation("CustomerReferredBy", fields: [referredByCodeId], references: [id])
  orders                    Order[]
  wallet                    DigitalWallet?
  ratingsGiven              Rating[]             @relation("CustomerRatings")
  commissionsAsReferrer     ReferralCommission[] @relation("ReferrerCommissions")
  commissionsAsReferred     ReferralCommission[] @relation("ReferredCommissions")
  chatRoomsAsCustomer       ChatRoom[]
  orderArrivalConflicts     OrderDriverArrivalConflict[]
  deliveryCompanyProxyFor   DeliveryCompany?       @relation("DeliveryCompanyProxyCustomer")

  @@map("customers")
}

model Driver {
  id          String       @id @default(uuid())
  userId      String       @unique @map("user_id")
  vehicleType String?      @map("vehicle_type")
  status      DriverStatus @default(INCOMPLETE)
  approvedAt  DateTime?    @map("approved_at")
  suspendedAt DateTime?    @map("suspended_at")
  description String?
  notifyGameEvents             Boolean    @default(false) @map("notify_game_events")

  /// Saved liveness evidence (JSON) when driver completes challenge but not yet document submit; expires after 24h.
  pendingLivenessSession       Json?      @map("pending_liveness_session")
  pendingVerificationSelfieUrl String?    @map("pending_verification_selfie_url")
  pendingLivenessExpiresAt     DateTime?  @map("pending_liveness_expires_at")

  // Relations
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverAccount            DriverAccount?
  weeklyAvailability       WeeklyAvailability?
  driverVerifications      DriverVerification[]
  assignments              DriverAssignment[]
  cashTransactions         CashTransaction[]
  ratingsReceived          Rating[]                  @relation("DriverRatings")
  driverLocations          DriverLocation[]
  performanceMetrics       DriverPerformanceMetrics?
  chatRoomsAsDriver        ChatRoom[]
  orderRejections          OrderDriverRejection[]
  urgentNotifyTargets      OrderUrgentNotifyTarget[]
  arrivalConflicts         OrderDriverArrivalConflict[]
  returnDepositFeedbacks   OrderReturnDepositFeedback[]

  @@map("drivers")
}

model Admin {
  id          String @id @default(uuid())
  superUserId String @unique @map("super_user_id")

  // Relations
  superUser SuperUser @relation(fields: [superUserId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model CustomerService {
  id          String                 @id @default(uuid())
  superUserId String                 @unique @map("super_user_id")
  roles       CustomerServiceRole[]  @default([])

  // Relations
  superUser      SuperUser       @relation(fields: [superUserId], references: [id], onDelete: Cascade)
  disputes       Dispute[]
  supportTickets SupportTicket[]
  governorates   CustomerServiceGovernorate[]

  @@map("customer_services")
}

// ============================================
// DRIVER FINANCIAL MANAGEMENT
// ============================================

model DriverAccount {
  id                  String   @id @default(uuid())
  driverId            String   @unique @map("driver_id")
  balance             Decimal  @default(0) @db.Decimal(10, 2) // Can be negative (debt)
  /// Coins reserved for outbound P2P transfers until completed or cancelled
  lockedForTransfers Decimal @default(0) @map("locked_for_transfers") @db.Decimal(10, 2)
  currency            String   @default("TND")
  avgDeliveryTime     Int?     @map("avg_delivery_time") // in minutes
  completedDeliveries Int      @default(0) @map("completed_deliveries")
  negativeBalanceSince DateTime? @map("negative_balance_since") // When balance first went negative
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  driver                 Driver                     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transactions           DriverTransaction[]
  driverWithdrawalRequests DriverWithdrawalRequest[]

  @@map("driver_accounts")
}

model DriverTransaction {
  id            String                @id @default(uuid())
  accountId     String                @map("account_id")
  type          DriverTransactionType
  amount        Decimal               @db.Decimal(10, 2)
  referenceId   String?               @map("reference_id") // Order ID, withdrawal ID, etc.
  referenceType String?               @map("reference_type")
  description   String?
  balanceAfter  Decimal               @db.Decimal(10, 2) @map("balance_after")
  createdAt     DateTime              @default(now()) @map("created_at")

  // Relations
  account DriverAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("driver_transactions")
}

model DriverWithdrawalRequest {
  id                     String           @id @default(uuid())
  driverAccountId        String           @map("driver_account_id")
  amount                 Decimal          @db.Decimal(10, 2)
  feeAmount              Decimal          @default(0) @map("fee_amount") @db.Decimal(10, 2)
  status                 ResponseType     @default(PENDING)
  payoutMethod           FiatPayoutMethod @default(BANK_TRANSFER) @map("payout_method")
  payoutBankHolderName   String?          @map("payout_bank_holder_name")
  payoutBankName         String?          @map("payout_bank_name")
  payoutBankAccountRef   String?          @map("payout_bank_account_ref")
  descriptionFromDriver  String?          @map("description_from_driver")
  descriptionFromStaff   String?          @map("description_from_staff")
  rejectionReason        String?          @map("rejection_reason")
  requestedAt            DateTime         @default(now()) @map("requested_at")
  processedAt            DateTime?        @map("processed_at")

  account DriverAccount @relation(fields: [driverAccountId], references: [id], onDelete: Cascade)

  @@index([driverAccountId, requestedAt])
  @@map("driver_withdrawal_requests")
}

// ============================================
// DRIVER AVAILABILITY
// ============================================

model WeeklyAvailability {
  id       String             @id @default(uuid())
  driverId String             @unique @map("driver_id")
  status   AvailabilityStatus @default(ACTIVE)

  // Relations
  driver            Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  dayAvailabilities DayAvailability[]

  @@map("weekly_availabilities")
}

model DayAvailability {
  id                   String    @id @default(uuid())
  weeklyAvailabilityId String    @map("weekly_availability_id")
  dayOfWeek            DayOfWeek @map("day_of_week")

  // Relations
  weeklyAvailability WeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)
  timePeriods        TimePeriod[]

  @@unique([weeklyAvailabilityId, dayOfWeek])
  @@map("day_availabilities")
}

model TimePeriod {
  id                String   @id @default(uuid())
  dayAvailabilityId String   @map("day_availability_id")
  startTime         DateTime @map("start_time") @db.Time()
  endTime           DateTime @map("end_time") @db.Time()

  // Relations
  dayAvailability DayAvailability @relation(fields: [dayAvailabilityId], references: [id], onDelete: Cascade)

  @@map("time_periods")
}

// ============================================
// DRIVER VERIFICATION
// ============================================

model DriverVerification {
  id           String       @id @default(uuid())
  driverId     String       @map("driver_id")
  documentType DocumentType @map("document_type")
  submittedAt  DateTime?    @map("submitted_at")
  verifiedAt   DateTime?    @map("verified_at")

  // Relations
  driver    Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([driverId])
  @@map("driver_verifications")
}

model Document {
  id                 String             @id @default(uuid())
  verificationId     String             @map("verification_id")
  documentImage      String?            @map("document_image")
  countryId          String?            @map("country_id")
  selfieImage        String?            @map("selfie_image")
  docImageTop        String?            @map("doc_image_top")
  docImageBottom     String?            @map("doc_image_bottom")
  selfieVerified     Boolean            @default(false) @map("selfie_verified")
  verificationStatus VerificationStatus @default(INCOMPLETE) @map("verification_status")
  firstName          String?            @map("first_name")
  lastName           String?            @map("last_name")
  dateOfBirth        DateTime?          @map("date_of_birth") @db.Date()
  idNumber           String?            @map("id_number")
  address            String?
  cardPlace          String?            @map("card_place")
  placeOfBirth       String?            @map("place_of_birth")
  dateOfIssue        DateTime?          @map("date_of_issue") @db.Date()
  mlAnalysis         Json?              @map("ml_analysis")
  /// BCP 47 locale code used for stored translations (e.g. en).
  translationLocale  String?            @map("translation_locale")
  /// Original + Google-translated declared vs OCR fields for staff review and audit.
  translationData    Json?              @map("translation_data")

  // Relations
  verification DriverVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  identityCard IdentityCard?
  passport     Passport?
  studentCard  StudentCard?
  driverCard   DriverCard?

  @@map("documents")
}

model IdentityCard {
  id         String  @id @default(uuid())
  documentId String  @unique @map("document_id")
  fatherName String? @map("father_name")
  motherName String? @map("mother_name")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("identity_cards")
}

model Passport {
  id                   String    @id @default(uuid())
  documentId           String    @unique @map("document_id")
  nationality          String?
  documentType         String?   @map("document_type")
  gender               String?
  expirationDate       DateTime? @map("expiration_date") @db.Date()
  passportLongNumber   String?   @map("passport_long_number")
  issuingAuthority     String?   @map("issuing_authority")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("passports")
}

model StudentCard {
  id         String  @id @default(uuid())
  documentId String  @unique @map("document_id")
  speciality String?
  university String?
  yearOfStudy String? @map("year_of_study")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("student_cards")
}

model DriverCard {
  id             String @id @default(uuid())
  documentId     String @unique @map("document_id")
  classification String

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("driver_cards")
}

// ============================================
// DRIVER PERFORMANCE
// ============================================

model DriverPerformanceMetrics {
  id                     String   @id @default(uuid())
  driverId               String   @unique @map("driver_id")
  totalOrders            Int      @default(0) @map("total_orders")
  completedOrders        Int      @default(0) @map("completed_orders")
  cancelledOrders        Int      @default(0) @map("cancelled_orders")
  avgRating              Decimal? @db.Decimal(4, 2) @map("avg_rating") // 0–10 scale; (3,2) max was 9.99 and overflowed at 10.0
  avgDeliveryTimeMinutes Int?     @map("avg_delivery_time_minutes")
  completionRate         Decimal? @db.Decimal(5, 2) @map("completion_rate") // percentage
  onTimeRate             Decimal? @db.Decimal(5, 2) @map("on_time_rate") // percentage
  lastCalculatedAt       DateTime @default(now()) @map("last_calculated_at")

  // Relations
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_performance_metrics")
}

// ============================================
// GEOGRAPHY
// ============================================

model Country {
  id             String  @id @default(uuid())
  name           String
  isoCode        String  @unique @map("iso_code")
  currencyCode   String  @map("currency_code")
  currencySymbol String  @map("currency_symbol")
  /// Optional BCP 47 / ISO 639-1 tag for driver-facing UX (e.g. liveness voice: "ar", "fr", "en"). Nullable — no data loss on existing rows.
  language       String? @map("language")
  isActive       Boolean @default(true) @map("is_active")

  // Relations
  governorates    Governorate[]
  pricingPolicies CountryPricingPolicy[]
  digitalWallets  DigitalWallet[]
  coinConfigs     CountryCoinConfig[]
  gameCountries   GameCountry[]

  @@map("countries")
}

model Governorate {
  id              String @id @default(uuid())
  nameGovernorate String @map("name_governorate")
  countryId       String @map("country_id")

  // Relations
  country                      Country                      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  delegations                  Delegation[]
  customerServiceGovernorates  CustomerServiceGovernorate[]

  @@map("governorates")
}

model Delegation {
  id                          String @id @default(uuid())
  nameDelegation              String @map("name_delegation")
  maxConfirmationDelayMinutes Int    @map("max_confirmation_delay_minutes")
  governorateId               String @map("governorate_id")

  // Relations
  governorate                 Governorate                 @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  addresses                   Address[]
  deliveryCompanyAddresses    DeliveryCompanyAddress[]

  @@map("delegations")
}

model Address {
  id           String  @id @default(uuid())
  latitude     Float?
  longitude    Float?
  street       String?
  /// Customer-chosen label e.g. "house of my father" (saved addresses only)
  nickname     String? @map("nickname")
  delegationId String  @map("delegation_id")
  userId       String? @map("user_id")

  // Relations
  delegation      Delegation @relation(fields: [delegationId], references: [id])
  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersAsPickup  Order[]    @relation("PickupAddress")
  ordersAsDropoff Order[]    @relation("DropoffAddress")

  @@map("addresses")
}

// ============================================
// PRICING
// ============================================

model CountryPricingPolicy {
  id               String            @id @default(uuid())
  pricePerKm       Decimal           @map("price_per_km") @db.Decimal(10, 2)
  baseFee          Decimal           @map("base_fee") @db.Decimal(10, 2)
  baseWeight       Decimal           @map("base_weight") @db.Decimal(10, 2)
  extraWeightStep  Decimal           @map("extra_weight_step") @db.Decimal(10, 2)
  extraWeightPrice Decimal           @map("extra_weight_price") @db.Decimal(10, 2)
  nightFee         Decimal           @map("night_fee") @db.Decimal(10, 2)
  platformFee      Decimal           @map("platform_fee") @db.Decimal(10, 2)
  /// Referral slice of base fee: invariant `base_fee = platform_fee + referral_commission`
  referralCommission Decimal         @map("referral_commission") @db.Decimal(10, 2)
  maxNegativeDays  Int               @map("max_negative_days")
  deliveryZoneType DeliveryZoneType? @map("delivery_zone_type")
  isActive         Boolean           @default(true) @map("is_active")
  countryId        String            @map("country_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  // Relations
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@map("country_pricing_policies")
}

// ============================================
// ORDERS
// ============================================

model Order {
  id                String      @id @default(uuid())
  customerId        String      @map("customer_id")
  pricingPolicyId   String      @map("pricing_policy_id")
  pickupAddressId   String?     @map("pickup_address_id")
  dropoffAddressId  String?     @map("dropoff_address_id")
  status            OrderStatus @default(DRAFT)
  paymentType       PaymentType
  description       String?
  weight            Decimal     @db.Decimal(10, 2)
  distanceKm        Decimal     @db.Decimal(10, 2) @map("distance_km")
  price             Decimal     @db.Decimal(10, 3)
  sourceType        OrderSourceType @default(NORMAL_CUSTOMER) @map("source_type")
  deliveryCompanyId String?     @map("delivery_company_id")
  deliveryCompanyDepartmentId String? @map("delivery_company_department_id")
  /// Department portal user who placed this company order (null = main admin / API without account context).
  deliveryCompanyDepartmentAccountId String? @map("delivery_company_department_account_id")
  nightFee          Decimal     @default(0) @db.Decimal(10, 2) @map("night_fee")
  extraWeightFee    Decimal     @default(0) @db.Decimal(10, 2) @map("extra_weight_fee")
  cancelAfterMinutes Int        @default(15) @map("cancel_after_minutes")
  /// Remaining auto-cancel seconds while order is searching for a driver.
  cancelTimerRemainingSeconds Int @default(900) @map("cancel_timer_remaining_seconds")
  /// Last timestamp when auto-cancel countdown resumed in SEARCHING_DRIVER.
  cancelTimerLastResumedAt   DateTime? @map("cancel_timer_last_resumed_at")
  /// Timestamp when auto-cancel countdown was paused.
  cancelTimerPausedAt        DateTime? @map("cancel_timer_paused_at")
  isNightDelivery   Boolean     @default(false) @map("is_night_delivery")
  /// Pickup at customer location only; driver brings goods from within delegation (≤2 km pricing)
  localPickupOnly   Boolean     @default(false) @map("local_pickup_only")
  /// Optional extra amount chosen by customer (e.g. long errand / service time). Charged price = calculated + this.
  customerExtraAmount Decimal   @default(0) @db.Decimal(10, 2) @map("customer_extra_amount")
  guestCheckout     Boolean     @default(false) @map("guest_checkout")
  trackingToken     String?     @unique @map("tracking_token")
  trackingExpiresAt DateTime?   @map("tracking_expires_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  urgentNotifyWavesSent       Int       @default(0) @map("urgent_notify_waves_sent")
  urgentNotifyCycleStartedAt  DateTime? @map("urgent_notify_cycle_started_at")
  urgentNotifyLastButtonAt    DateTime? @map("urgent_notify_last_button_at")
  urgentNotifyCycleId         String?   @map("urgent_notify_cycle_id")
  /// When status is PENDING_PUBLISH, drivers become eligible at this instant (UTC).
  scheduledPublishAt DateTime? @map("scheduled_publish_at")

  // Relations
  customer            Customer              @relation(fields: [customerId], references: [id])
  deliveryCompany     DeliveryCompany?      @relation(fields: [deliveryCompanyId], references: [id])
  deliveryCompanyDepartment DeliveryCompanyAddress? @relation(fields: [deliveryCompanyDepartmentId], references: [id], onDelete: SetNull)
  createdByDepartmentAccount DeliveryCompanyDepartmentAccount? @relation(fields: [deliveryCompanyDepartmentAccountId], references: [id], onDelete: SetNull)
  pricingPolicy       CountryPricingPolicy  @relation(fields: [pricingPolicyId], references: [id])
  pickupAddress       Address?              @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  dropoffAddress      Address?              @relation("DropoffAddress", fields: [dropoffAddressId], references: [id])
  driverAssignment    DriverAssignment?
  cashTransaction     CashTransaction?
  walletTransactions  WalletTransaction[]
  referralCommissions ReferralCommission[]
  rating              Rating?
  dispute             Dispute?
  chatRooms           ChatRoom[]
  driverLocations     DriverLocation[]
  driverRejections    OrderDriverRejection[]
  urgentNotifyTargets OrderUrgentNotifyTarget[]
  arrivalConflict     OrderDriverArrivalConflict?
  returnDepositFeedbacks OrderReturnDepositFeedback[]
  deliveryCompanyTransactions DeliveryCompanyTransaction[]

  @@index([customerId, status])
  @@index([deliveryCompanyId, status])
  @@index([deliveryCompanyDepartmentId, status])
  @@index([deliveryCompanyDepartmentAccountId])
  @@index([status, createdAt])
  @@map("orders")
}

model DeliveryCompany {
  id                      String               @id @default(uuid())
  name                    String
  contactEmail            String?              @unique @map("contact_email")
  passwordHash            String?              @map("password_hash")
  legalName               String?              @map("legal_name")
  taxId                   String?              @map("tax_id")
  status                  DeliveryCompanyStatus @default(PENDING)
  onboardingCompleted     Boolean              @default(false) @map("onboarding_completed")
  defaultRefundDestinationType DeliveryCompanyRefundDestinationType? @map("default_refund_destination_type")
  defaultDiscountPercent  Decimal?             @db.Decimal(5, 2) @map("default_discount_percent")
  maxNegativeBalance      Decimal              @default(0) @db.Decimal(10, 2) @map("max_negative_balance")
  coinBalance             Decimal              @default(0) @db.Decimal(12, 3) @map("coin_balance")
  lockedCoins             Decimal              @default(0) @db.Decimal(12, 3) @map("locked_coins")
  /// Last path reported by main company portal (suppress duplicate order-created inbox noise).
  companyPortalPresencePath String?          @map("company_portal_presence_path")
  companyPortalPresenceAt   DateTime?        @map("company_portal_presence_at")
  proxyCustomerId         String?              @unique @map("proxy_customer_id")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  proxyCustomer           Customer?            @relation("DeliveryCompanyProxyCustomer", fields: [proxyCustomerId], references: [id])
  addresses               DeliveryCompanyAddress[]
  bankAccounts            DeliveryCompanyBankAccount[]
  apiKeys                 DeliveryCompanyApiKey[]
  refundRequests          DeliveryCompanyRefundRequest[]
  transactions            DeliveryCompanyTransaction[]
  departmentAccounts      DeliveryCompanyDepartmentAccount[]
  idempotencyKeys         DeliveryCompanyIdempotencyKey[]
  budgetPolicies          DeliveryCompanyDepartmentBudgetPolicy[]
  scheduledBudgetTransfers DeliveryCompanyScheduledBudgetTransfer[]
  budgetWallets           DeliveryCompanyDepartmentBudgetWallet[]
  budgetRequests          DeliveryCompanyDepartmentBudgetRequest[]
  orders                  Order[]
  auditLogs               DeliveryCompanyAuditLog[]

  @@index([status, createdAt])
  @@map("delivery_companies")
}

model DeliveryCompanyAuditLog {
  id                String   @id @default(uuid())
  deliveryCompanyId String   @map("delivery_company_id")
  actionType        String   @map("action_type")
  actorType         String   @map("actor_type")
