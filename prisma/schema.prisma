  isAutoApproveEnabled  Boolean                         @default(false) @map("is_auto_approve_enabled")
  isActive              Boolean                         @default(true) @map("is_active")
  createdAt             DateTime                        @default(now()) @map("created_at")
  updatedAt             DateTime                        @updatedAt @map("updated_at")

  deliveryCompany       DeliveryCompany                 @relation(fields: [deliveryCompanyId], references: [id], onDelete: Cascade)
  departmentAccount     DeliveryCompanyDepartmentAccount @relation(fields: [departmentAccountId], references: [id], onDelete: Cascade)

  @@index([deliveryCompanyId, isActive])
  @@map("delivery_company_department_budget_policies")
}

// Recurring automatic transfers to a department budget wallet (main configures).
