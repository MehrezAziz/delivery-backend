// prisma/schema.prisma
// Complete schema for On-Demand Delivery Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CUSTOMER
  DRIVER
}

enum UserGender {
  MALE
  FEMALE
}

enum SuperUserRole {
  ADMIN
  CUSTOMER_SERVICE
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CustomerStatus {
  CREATED
  VERIFIED
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum DriverStatus {
  INCOMPLETE
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  PAUSED
}

enum OrderStatus {
  DRAFT
  SEARCHING_DRIVER
  PENDING_CUSTOMER_APPROVAL
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  PICKED_UP
  DELIVERING
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
  DISPUTED
}

enum PaymentType {
  COD
  WALLET
}

enum DriverTransactionType {
  PLATFORM_FEE
  WITHDRAWAL
  BONUS
  PENALTY
  ADJUSTMENT
  REFUND
  DISPUTE_DEBIT
  DEPOSIT
}

enum WalletTransactionType {
  TOP_UP
  ORDER_PAYMENT
  REFUND
  WITHDRAWAL_REQUEST
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  BONUS
  REFERRAL_REWARD
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReferenceType {
  STRIPE_TOPUP
  ORDER
  REFERRAL
  WITHDRAWAL
  ADMIN_ADJUSTMENT
}

enum ResponseType {
  PENDING
  ACCEPTED
  REJECTED
  ON_REVIEW
}

enum DocumentType {
  PASSPORT
  ID_CARD
  STUDENT_CARD
  DRIVER_CARD
}

enum VerificationStatus {
  INCOMPLETE
  SUBMITTED
  VERIFIED
  REJECTED
}

enum RestrictionType {
  SUSPENSION
  BLOCK
  WARNING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ReferralCodeType {
  FIXED
  PERCENTAGE
}

enum ReferralCommissionStatus {
  PENDING
  PAID
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  ORDER_ISSUE
  PAYMENT
  TECHNICAL
  OTHER
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ChatStatus {
  ACTIVE
  CLOSED
}

enum MessageSenderType {
  CUSTOMER
  DRIVER
  SYSTEM
}

enum NotificationType {
  // Customer - Order Lifecycle
  ORDER_CREATED
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  PACKAGE_PICKED_UP
  DELIVERY_IN_PROGRESS
  ORDER_DELIVERED
  ORDER_CANCELLED
  NO_DRIVER_FOUND
  // Customer - Payment & Wallet
  WALLET_TOPUP_SUCCESS
  WALLET_TOPUP_FAILED
  LOW_WALLET_BALANCE
  ORDER_PAYMENT_DEDUCTED
  REFUND_PROCESSED
  WITHDRAWAL_STATUS
  // Customer - Referral
  REFERRAL_BONUS
  REFERRED_FRIEND_REGISTERED
  // Customer - Account
  ACCOUNT_CREATED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  // Customer - Support
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  SUPPORT_TICKET_REPLY
  // Customer - Chat
  NEW_MESSAGE_FROM_DRIVER
  // Driver - Order Opportunities
  NEW_ORDER_AVAILABLE
  ORDER_EXPIRED
  // Driver - Active Order
  ORDER_CANCELLED_BY_CUSTOMER
  PICKUP_REMINDER
  // Driver - Account
  DOCUMENTS_SUBMITTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  DRIVER_ACCOUNT_SUSPENDED
  // Driver - Financial
  PAYMENT_RECEIVED_COD
  PAYMENT_CREDITED_WALLET
  NEGATIVE_BALANCE_WARNING
  ACCOUNT_BLOCKED_DEBT
  WITHDRAWAL_PROCESSED
  // Driver - Performance
  CUSTOMER_RATED_YOU
  PERFORMANCE_MILESTONE
  // Driver - Chat
  NEW_MESSAGE_FROM_CUSTOMER
  // Admin - Driver Management
  NEW_DRIVER_REGISTRATION
  DRIVER_DOCUMENTS_SUBMITTED
  DRIVER_PERFORMANCE_ALERT
  DRIVER_DEBT_THRESHOLD
  // Admin - Order Management
  ORDER_STUCK_NO_DRIVER
  HIGH_VALUE_ORDER
  ORDER_CANCELLED_AFTER_ASSIGNMENT
  // Admin - Disputes
  NEW_DISPUTE_CREATED
  DISPUTE_ESCALATED
  // Admin - Financial
  LARGE_WITHDRAWAL_REQUEST
  PAYMENT_GATEWAY_FAILURE
  DAILY_REVENUE_REPORT
  // Admin - System Health
  SERVER_ERROR_SPIKE
  DATABASE_PERFORMANCE_ALERT
  // Admin - User Management
  SUSPICIOUS_ACTIVITY
  BULK_REGISTRATION_DETECTED
  // CS - Support
  NEW_SUPPORT_TICKET
  TICKET_ASSIGNED
  CUSTOMER_REPLIED_TICKET
  URGENT_TICKET_UNRESOLVED
  SUPPORT_HUMAN_REQUESTED
  // CS - Disputes
  DISPUTE_ASSIGNED
  DISPUTE_REQUIRES_DECISION
  // CS - Order Monitoring
  DELAYED_ORDER_ALERT
  NEW_ORDER_FOR_CUSTOMER_SERVICE
  CUSTOMER_REJECTED_ARRIVED_DRIVER_CS
  CUSTOMER_REJECTED_ARRIVED_DRIVER_TO_DRIVER
  ARRIVAL_CONFLICT_DRIVER_FEEDBACK_CS
}

enum NotificationPriority {
  LOW       // Informational only
  MEDIUM    // Standard notification
  HIGH      // Important, requires attention
  CRITICAL  // Urgent, requires immediate action
}

enum NotificationChannel {
  PUSH         // Mobile push notification
  IN_APP       // In-app notification center
  EMAIL        // Email notification
  SMS          // SMS (critical only)
  WEB_SOCKET   // Real-time browser notification
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum AvailabilityStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryZoneType {
  SAME_DELEGATION
  SAME_GOVERNORATE
  DIFFERENT_GOVERNORATE
  DIFFERENT_COUNTRY
}

enum OrderDriverArrivalConflictStatus {
  PENDING
  RESOLVED_FORGIVE
  RESOLVED_SUSPEND_CUSTOMER
  RESOLVED_SUSPEND_DRIVER
}

enum CustomerServiceRole {
  READ_DRIVER_PROFILE
  READ_CUSTOMER_PROFILE
  UPDATE_DRIVER_STATUS
  UPDATE_CUSTOMER_STATUS
  VERIFY_ACCOUNTS
  ACCEPT_LOCAL_PAYMENT
  VIEW_DELIVERIES
  MANAGE_DISPUTES
  MANAGE_SUPPORT_TICKETS
  VIEW_FINANCIAL_REPORTS
  MANAGE_FINANCIAL_REPORTS
}

// ============================================
// CORE USER ENTITIES
// ============================================

model User {
  id          String      @id @default(uuid())
  phone       String?      @unique
  password    String?     // Optional: for email/password login (nullable for OTP-only users)
  firstName   String?     @map("first_name")
  secondName  String?     @map("second_name")
  image       String?
  myEmail     String?     @map("my_email")
  userGender  UserGender? @map("user_gender")
  googleId    String?     @unique @map("google_id") // Google's unique user ID
  googleEmail String?     @unique @map("google_email") // Email from Google
  role        UserRole
  fcmToken    String?     @map("fcm_token")
  fcmPlatform String?     @map("fcm_platform") // 'android' or 'ios'
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  addresses        Address[]
  customer         Customer?
  driver           Driver?
  userRestrictions UserRestriction[]
  sentMessages     Message[]
  supportTickets   SupportTicket[]

  @@map("users")
}

model SuperUser {
  id            String        @id @default(uuid())
  telephone     String        @unique
  pseudo        String        @unique
  email         String        @unique
  superPassword String        @map("super_password") // Hashed password for admin/CS login
  role          SuperUserRole
  status        UserStatus    @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  admin           Admin?
  customerService CustomerService?
  actionLogs      ActionLog[]

  @@map("super_users")
}

// ============================================
// USER TYPES
// ============================================

model Customer {
  id               String         @id @default(uuid())
  userId           String         @unique @map("user_id")
  completedOrders  Int            @default(0) @map("completed_orders")
  customerStatus   CustomerStatus @default(CREATED) @map("customer_status")
  referredByCodeId String?        @map("referred_by_code_id")
  termsAcceptedAt  DateTime?      @map("terms_accepted_at")

  // Relations
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  myReferralCode            ReferralCode?        @relation("CustomerOwnedCode")
  referredByCode            ReferralCode?        @relation("CustomerReferredBy", fields: [referredByCodeId], references: [id])
  orders                    Order[]
  wallet                    DigitalWallet?
  ratingsGiven              Rating[]             @relation("CustomerRatings")
  commissionsAsReferrer     ReferralCommission[] @relation("ReferrerCommissions")
  commissionsAsReferred     ReferralCommission[] @relation("ReferredCommissions")
  chatRoomsAsCustomer       ChatRoom[]
  orderArrivalConflicts     OrderDriverArrivalConflict[]

  @@map("customers")
}

model Driver {
  id          String       @id @default(uuid())
  userId      String       @unique @map("user_id")
  vehicleType String?      @map("vehicle_type")
  status      DriverStatus @default(INCOMPLETE)
  approvedAt  DateTime?    @map("approved_at")
  suspendedAt DateTime?    @map("suspended_at")
  description String?

  /// Saved liveness evidence (JSON) when driver completes challenge but not yet document submit; expires after 24h.
  pendingLivenessSession       Json?      @map("pending_liveness_session")
  pendingVerificationSelfieUrl String?    @map("pending_verification_selfie_url")
  pendingLivenessExpiresAt     DateTime?  @map("pending_liveness_expires_at")

  // Relations
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverAccount            DriverAccount?
  weeklyAvailability       WeeklyAvailability?
  driverVerifications      DriverVerification[]
  assignments              DriverAssignment[]
  cashTransactions         CashTransaction[]
  ratingsReceived          Rating[]                  @relation("DriverRatings")
  driverLocations          DriverLocation[]
  performanceMetrics       DriverPerformanceMetrics?
  chatRoomsAsDriver        ChatRoom[]
  orderRejections          OrderDriverRejection[]
  urgentNotifyTargets      OrderUrgentNotifyTarget[]
  arrivalConflicts         OrderDriverArrivalConflict[]

  @@map("drivers")
}

model Admin {
  id          String @id @default(uuid())
  superUserId String @unique @map("super_user_id")

  // Relations
  superUser SuperUser @relation(fields: [superUserId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model CustomerService {
  id          String                 @id @default(uuid())
  superUserId String                 @unique @map("super_user_id")
  roles       CustomerServiceRole[]  @default([])

  // Relations
  superUser      SuperUser       @relation(fields: [superUserId], references: [id], onDelete: Cascade)
  disputes       Dispute[]
  supportTickets SupportTicket[]
  governorates   CustomerServiceGovernorate[]

  @@map("customer_services")
}

// ============================================
// DRIVER FINANCIAL MANAGEMENT
// ============================================

model DriverAccount {
  id                  String   @id @default(uuid())
  driverId            String   @unique @map("driver_id")
  balance             Decimal  @default(0) @db.Decimal(10, 2) // Can be negative (debt)
  currency            String   @default("TND")
  avgDeliveryTime     Int?     @map("avg_delivery_time") // in minutes
  completedDeliveries Int      @default(0) @map("completed_deliveries")
  negativeBalanceSince DateTime? @map("negative_balance_since") // When balance first went negative
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  driver       Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transactions DriverTransaction[]

  @@map("driver_accounts")
}

model DriverTransaction {
  id            String                @id @default(uuid())
  accountId     String                @map("account_id")
  type          DriverTransactionType
  amount        Decimal               @db.Decimal(10, 2)
  referenceId   String?               @map("reference_id") // Order ID, withdrawal ID, etc.
  referenceType String?               @map("reference_type")
  description   String?
  balanceAfter  Decimal               @db.Decimal(10, 2) @map("balance_after")
  createdAt     DateTime              @default(now()) @map("created_at")

  // Relations
  account DriverAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("driver_transactions")
}

// ============================================
// DRIVER AVAILABILITY
// ============================================

model WeeklyAvailability {
  id       String             @id @default(uuid())
  driverId String             @unique @map("driver_id")
  status   AvailabilityStatus @default(ACTIVE)

  // Relations
  driver            Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  dayAvailabilities DayAvailability[]

  @@map("weekly_availabilities")
}

model DayAvailability {
  id                   String    @id @default(uuid())
  weeklyAvailabilityId String    @map("weekly_availability_id")
  dayOfWeek            DayOfWeek @map("day_of_week")

  // Relations
  weeklyAvailability WeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)
  timePeriods        TimePeriod[]

  @@unique([weeklyAvailabilityId, dayOfWeek])
  @@map("day_availabilities")
}

model TimePeriod {
  id                String   @id @default(uuid())
  dayAvailabilityId String   @map("day_availability_id")
  startTime         DateTime @map("start_time") @db.Time()
  endTime           DateTime @map("end_time") @db.Time()

  // Relations
  dayAvailability DayAvailability @relation(fields: [dayAvailabilityId], references: [id], onDelete: Cascade)

  @@map("time_periods")
}

// ============================================
// DRIVER VERIFICATION
// ============================================

model DriverVerification {
  id           String       @id @default(uuid())
  driverId     String       @map("driver_id")
  documentType DocumentType @map("document_type")
  submittedAt  DateTime?    @map("submitted_at")
  verifiedAt   DateTime?    @map("verified_at")

  // Relations
  driver    Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([driverId])
  @@map("driver_verifications")
}

model Document {
  id                 String             @id @default(uuid())
  verificationId     String             @map("verification_id")
  documentImage      String?            @map("document_image")
  countryId          String?            @map("country_id")
  selfieImage        String?            @map("selfie_image")
  docImageTop        String?            @map("doc_image_top")
  docImageBottom     String?            @map("doc_image_bottom")
  selfieVerified     Boolean            @default(false) @map("selfie_verified")
  verificationStatus VerificationStatus @default(INCOMPLETE) @map("verification_status")
  firstName          String?            @map("first_name")
  lastName           String?            @map("last_name")
  dateOfBirth        DateTime?          @map("date_of_birth") @db.Date()
  idNumber           String?            @map("id_number")
  address            String?
  cardPlace          String?            @map("card_place")
  placeOfBirth       String?            @map("place_of_birth")
  dateOfIssue        DateTime?          @map("date_of_issue") @db.Date()
  mlAnalysis         Json?              @map("ml_analysis")
  /// BCP 47 locale code used for stored translations (e.g. en).
  translationLocale  String?            @map("translation_locale")
  /// Original + Google-translated declared vs OCR fields for staff review and audit.
  translationData    Json?              @map("translation_data")

  // Relations
  verification DriverVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  identityCard IdentityCard?
  passport     Passport?
  studentCard  StudentCard?
  driverCard   DriverCard?

  @@map("documents")
}

model IdentityCard {
  id         String  @id @default(uuid())
  documentId String  @unique @map("document_id")
  fatherName String? @map("father_name")
  motherName String? @map("mother_name")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("identity_cards")
}

model Passport {
  id                   String    @id @default(uuid())
  documentId           String    @unique @map("document_id")
  nationality          String?
  documentType         String?   @map("document_type")
  gender               String?
  expirationDate       DateTime? @map("expiration_date") @db.Date()
  passportLongNumber   String?   @map("passport_long_number")
  issuingAuthority     String?   @map("issuing_authority")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("passports")
}

model StudentCard {
  id         String  @id @default(uuid())
  documentId String  @unique @map("document_id")
  speciality String?
  university String?
  yearOfStudy String? @map("year_of_study")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("student_cards")
}

model DriverCard {
  id             String @id @default(uuid())
  documentId     String @unique @map("document_id")
  classification String

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("driver_cards")
}

// ============================================
// DRIVER PERFORMANCE
// ============================================

model DriverPerformanceMetrics {
  id                     String   @id @default(uuid())
  driverId               String   @unique @map("driver_id")
  totalOrders            Int      @default(0) @map("total_orders")
  completedOrders        Int      @default(0) @map("completed_orders")
  cancelledOrders        Int      @default(0) @map("cancelled_orders")
  avgRating              Decimal? @db.Decimal(4, 2) @map("avg_rating") // 0–10 scale; (3,2) max was 9.99 and overflowed at 10.0
  avgDeliveryTimeMinutes Int?     @map("avg_delivery_time_minutes")
  completionRate         Decimal? @db.Decimal(5, 2) @map("completion_rate") // percentage
  onTimeRate             Decimal? @db.Decimal(5, 2) @map("on_time_rate") // percentage
  lastCalculatedAt       DateTime @default(now()) @map("last_calculated_at")

  // Relations
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_performance_metrics")
}

// ============================================
// GEOGRAPHY
// ============================================

model Country {
  id             String  @id @default(uuid())
  name           String
  isoCode        String  @unique @map("iso_code")
  currencyCode   String  @map("currency_code")
  currencySymbol String  @map("currency_symbol")
  /// Optional BCP 47 / ISO 639-1 tag for driver-facing UX (e.g. liveness voice: "ar", "fr", "en"). Nullable — no data loss on existing rows.
  language       String? @map("language")
  isActive       Boolean @default(true) @map("is_active")

  // Relations
  governorates    Governorate[]
  pricingPolicies CountryPricingPolicy[]
  digitalWallets  DigitalWallet[]

  @@map("countries")
}

model Governorate {
  id              String @id @default(uuid())
  nameGovernorate String @map("name_governorate")
  countryId       String @map("country_id")

  // Relations
  country                      Country                      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  delegations                  Delegation[]
  customerServiceGovernorates  CustomerServiceGovernorate[]

  @@map("governorates")
}

model Delegation {
  id                          String @id @default(uuid())
  nameDelegation              String @map("name_delegation")
  maxConfirmationDelayMinutes Int    @map("max_confirmation_delay_minutes")
  governorateId               String @map("governorate_id")

  // Relations
  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  addresses   Address[]

  @@map("delegations")
}

model Address {
  id           String  @id @default(uuid())
  latitude     Float?
  longitude    Float?
  street       String?
  /// Customer-chosen label e.g. "house of my father" (saved addresses only)
  nickname     String? @map("nickname")
  delegationId String  @map("delegation_id")
  userId       String? @map("user_id")

  // Relations
  delegation      Delegation @relation(fields: [delegationId], references: [id])
  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersAsPickup  Order[]    @relation("PickupAddress")
  ordersAsDropoff Order[]    @relation("DropoffAddress")

  @@map("addresses")
}

// ============================================
// PRICING
// ============================================

model CountryPricingPolicy {
  id               String            @id @default(uuid())
  pricePerKm       Decimal           @map("price_per_km") @db.Decimal(10, 2)
  baseFee          Decimal           @map("base_fee") @db.Decimal(10, 2)
  baseWeight       Decimal           @map("base_weight") @db.Decimal(10, 2)
  extraWeightStep  Decimal           @map("extra_weight_step") @db.Decimal(10, 2)
  extraWeightPrice Decimal           @map("extra_weight_price") @db.Decimal(10, 2)
  nightFee         Decimal           @map("night_fee") @db.Decimal(10, 2)
  platformFee      Decimal           @map("platform_fee") @db.Decimal(10, 2)
  maxNegativeDays  Int               @map("max_negative_days")
  deliveryZoneType DeliveryZoneType? @map("delivery_zone_type")
  isActive         Boolean           @default(true) @map("is_active")
  countryId        String            @map("country_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  // Relations
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@map("country_pricing_policies")
}

// ============================================
// ORDERS
// ============================================

model Order {
  id                String      @id @default(uuid())
  customerId        String      @map("customer_id")
  pricingPolicyId   String      @map("pricing_policy_id")
  pickupAddressId   String?     @map("pickup_address_id")
  dropoffAddressId  String?     @map("dropoff_address_id")
  status            OrderStatus @default(DRAFT)
  paymentType       PaymentType
  description       String?
  weight            Decimal     @db.Decimal(10, 2)
  distanceKm        Decimal     @db.Decimal(10, 2) @map("distance_km")
  price             Decimal     @db.Decimal(10, 2)
  nightFee          Decimal     @default(0) @db.Decimal(10, 2) @map("night_fee")
  extraWeightFee    Decimal     @default(0) @db.Decimal(10, 2) @map("extra_weight_fee")
  cancelAfterMinutes Int        @default(15) @map("cancel_after_minutes")
  /// Remaining auto-cancel seconds while order is searching for a driver.
  cancelTimerRemainingSeconds Int @default(900) @map("cancel_timer_remaining_seconds")
  /// Last timestamp when auto-cancel countdown resumed in SEARCHING_DRIVER.
  cancelTimerLastResumedAt   DateTime? @map("cancel_timer_last_resumed_at")
  /// Timestamp when auto-cancel countdown was paused.
  cancelTimerPausedAt        DateTime? @map("cancel_timer_paused_at")
  isNightDelivery   Boolean     @default(false) @map("is_night_delivery")
  /// Pickup at customer location only; driver brings goods from within delegation (≤2 km pricing)
  localPickupOnly   Boolean     @default(false) @map("local_pickup_only")
  /// Optional extra amount chosen by customer (e.g. long errand / service time). Charged price = calculated + this.
  customerExtraAmount Decimal   @default(0) @db.Decimal(10, 2) @map("customer_extra_amount")
  guestCheckout     Boolean     @default(false) @map("guest_checkout")
  trackingToken     String?     @unique @map("tracking_token")
  trackingExpiresAt DateTime?   @map("tracking_expires_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  urgentNotifyWavesSent       Int       @default(0) @map("urgent_notify_waves_sent")
  urgentNotifyCycleStartedAt  DateTime? @map("urgent_notify_cycle_started_at")
  urgentNotifyLastButtonAt    DateTime? @map("urgent_notify_last_button_at")
  urgentNotifyCycleId         String?   @map("urgent_notify_cycle_id")

  // Relations
  customer            Customer              @relation(fields: [customerId], references: [id])
  pricingPolicy       CountryPricingPolicy  @relation(fields: [pricingPolicyId], references: [id])
  pickupAddress       Address?              @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  dropoffAddress      Address?              @relation("DropoffAddress", fields: [dropoffAddressId], references: [id])
  driverAssignment    DriverAssignment?
  cashTransaction     CashTransaction?
  walletTransactions  WalletTransaction[]
  referralCommissions ReferralCommission[]
  rating              Rating?
  dispute             Dispute?
  chatRooms           ChatRoom[]
  driverLocations     DriverLocation[]
  driverRejections    OrderDriverRejection[]
  urgentNotifyTargets OrderUrgentNotifyTarget[]
  arrivalConflict     OrderDriverArrivalConflict?

  @@index([customerId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model CustomerServiceGovernorate {
  id                  String          @id @default(uuid())
  customerServiceId   String          @map("customer_service_id")
  governorateId       String          @map("governorate_id")
  customerService     CustomerService @relation(fields: [customerServiceId], references: [id], onDelete: Cascade)
  governorate         Governorate     @relation(fields: [governorateId], references: [id], onDelete: Cascade)

  @@unique([customerServiceId, governorateId])
  @@map("customer_service_governorates")
}

model OrderUrgentNotifyTarget {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  cycleId   String   @map("cycle_id")
  driverId  String   @map("driver_id")
  waveIndex Int      @map("wave_index")
  createdAt DateTime @default(now()) @map("created_at")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([orderId, cycleId, driverId])
  @@index([orderId, cycleId])
  @@map("order_urgent_notify_targets")
}

model OrderDriverArrivalConflict {
  id                     String                         @id @default(uuid())
  orderId                String                         @unique @map("order_id")
  customerId             String                         @map("customer_id")
  driverId               String                         @map("driver_id")
  customerReason         String                         @map("customer_reason")
  driverFeedback         String?                        @map("driver_feedback")
  status                 OrderDriverArrivalConflictStatus @default(PENDING)
  resolvedBySuperUserId  String?                        @map("resolved_by_super_user_id")
  resolvedAt             DateTime?                      @map("resolved_at")
  resolutionNote         String?                        @map("resolution_note")
  createdAt              DateTime                       @default(now()) @map("created_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("order_driver_arrival_conflicts")
}

model DriverAssignment {
  id                String    @id @default(uuid())
  orderId           String    @unique @map("order_id")
  driverId          String    @map("driver_id")
  acceptedAt        DateTime? @map("accepted_at")
  rejectedAt        DateTime? @map("rejected_at")
  arrivedAt         DateTime? @map("arrived_at")
  pickedUpAt        DateTime? @map("picked_up_at")
  deliveredAt       DateTime? @map("delivered_at")
  image1Proof       String?   @map("image1_proof")
  image2Proof       String?   @map("image2_proof")
  feedback          String?
  cancelledBy       String?   @map("cancelled_by") // userId who cancelled
  cancellationReason String?  @map("cancellation_reason")
  notificationSentAt DateTime? @map("notification_sent_at")

  // Relations
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, acceptedAt])
  @@map("driver_assignments")
}

model CashTransaction {
  id            String   @id @default(uuid())
  orderId       String   @unique @map("order_id")
  driverId      String   @map("driver_id")
  cashCollected Decimal  @db.Decimal(10, 2) @map("cash_collected")
  platformFee   Decimal  @db.Decimal(10, 2) @map("platform_fee")
  driverNet     Decimal  @db.Decimal(10, 2) @map("driver_net")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id])

  @@map("cash_transactions")
}

// ============================================
// CUSTOMER WALLET
// ============================================

model DigitalWallet {
  id         String  @id @default(uuid())
  customerId String  @unique @map("customer_id")
  balance    Decimal @default(0) @db.Decimal(10, 2)
  currency   String  @default("TND")
  countryId  String  @map("country_id")
  discount   Decimal @default(0) @db.Decimal(10, 2)
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  country             Country              @relation(fields: [countryId], references: [id])
  transactions        WalletTransaction[]
  withdrawalRequests  WithdrawalRequest[]

  @@map("digital_wallets")
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String                @map("wallet_id")
  orderId       String?               @map("order_id")
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(10, 2)
  status        TransactionStatus     @default(PENDING)
  referenceId   String?               @map("reference_id") // External payment reference (Stripe, etc.)
  referenceType ReferenceType?        @map("reference_type")
  balanceAfter  Decimal               @db.Decimal(10, 2) @map("balance_after")
  createdAt     DateTime              @default(now()) @map("created_at")

  // Relations
  wallet DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order?        @relation(fields: [orderId], references: [id])

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id                    String       @id @default(uuid())
  walletId              String       @map("wallet_id")
  amount                Decimal      @db.Decimal(10, 2)
  status                ResponseType @default(PENDING)
  descriptionOfCustomer String?      @map("description_of_customer")
  descriptionOfAdmin    String?      @map("description_of_admin")
  requestedAt           DateTime     @default(now()) @map("requested_at")
  processedAt           DateTime?    @map("processed_at")

  // Relations
  wallet DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("withdrawal_requests")
}

// ============================================
// REFERRAL SYSTEM
// ============================================

model ReferralCode {
  id                  String             @id @default(uuid())
  code                String             @unique
  type                ReferralCodeType
  value               Decimal            @db.Decimal(10, 2)
  maxDiscountAmount   Decimal?           @db.Decimal(10, 2) @map("max_discount_amount")
  minOrderAmount      Decimal?           @db.Decimal(10, 2) @map("min_order_amount")
  usageLimit          Int?               @map("usage_limit")
  usagePerUserLimit   Int?               @map("usage_per_user_limit")
  validFrom           DateTime?          @map("valid_from")
  validUntil          DateTime?          @map("valid_until")
  active              Boolean            @default(true)
  createdBy           String?            @map("created_by") // adminId or 'system'
  ownerId             String?            @unique @map("owner_id") // customerId (nullable for admin codes)
  totalUses           Int                @default(0) @map("total_uses")

  // Relations
  owner               Customer?            @relation("CustomerOwnedCode", fields: [ownerId], references: [id])
  usersReferred       Customer[]           @relation("CustomerReferredBy")
  commissions         ReferralCommission[]

  @@map("referral_codes")
}

model ReferralCommission {
  id                  String                   @id @default(uuid())
  referralCodeId      String                   @map("referral_code_id")
  referrerCustomerId  String                   @map("referrer_customer_id")
  referredCustomerId  String                   @map("referred_customer_id")
  orderId             String                   @map("order_id")
  commissionAmount    Decimal                  @db.Decimal(10, 2) @map("commission_amount")
  status              ReferralCommissionStatus @default(PAID)
  createdAt           DateTime                 @default(now()) @map("created_at")

  // Relations
  referralCode       ReferralCode @relation(fields: [referralCodeId], references: [id])
  referrerCustomer   Customer     @relation("ReferrerCommissions", fields: [referrerCustomerId], references: [id])
  referredCustomer   Customer     @relation("ReferredCommissions", fields: [referredCustomerId], references: [id])
  order              Order        @relation(fields: [orderId], references: [id])

  @@map("referral_commissions")
}

// ============================================
// RATINGS & REVIEWS
// ============================================

model Rating {
  id         String   @id @default(uuid())
  orderId    String   @unique @map("order_id")
  customerId String   @map("customer_id")
  driverId   String   @map("driver_id")
  score      Int      @db.SmallInt // 0-10
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation("CustomerRatings", fields: [customerId], references: [id])
  driver   Driver   @relation("DriverRatings", fields: [driverId], references: [id])

  @@index([driverId, score])
  @@map("ratings")
}

// ============================================
// CHAT SYSTEM
// ============================================

model ChatRoom {
  id         String     @id @default(uuid())
  orderId    String     @map("order_id")
  customerId String     @map("customer_id")
  driverId   String     @map("driver_id")
  status     ChatStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at")

  // Relations
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id])
  driver   Driver    @relation(fields: [driverId], references: [id])
  messages Message[]

  @@index([orderId, status, createdAt])
  @@map("chat_rooms")
}

model Message {
  id         String            @id @default(uuid())
  chatRoomId String            @map("chat_room_id")
  senderId   String            @map("sender_id")
  senderType MessageSenderType @map("sender_type")
  content    String
  image      String?
  timestamp  DateTime          @default(now())
  readAt     DateTime?         @map("read_at")

  // Relations
  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id])

  @@index([chatRoomId, timestamp])
  @@map("messages")
}

// ============================================
// GPS TRACKING
// ============================================

model DriverLocation {
  id        String   @id @default(uuid())
  driverId  String   @map("driver_id")
  orderId   String?  @map("order_id") // Nullable: only set when actively delivering
  latitude  Float
  longitude Float
  accuracy  Float?   // in meters
  timestamp DateTime @default(now())

  // Relations
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([driverId, timestamp])
  @@index([orderId, timestamp])
  @@map("driver_locations")
}

// ============================================
// DISPUTES & SUPPORT
// ============================================

model Dispute {
  id                  String        @id @default(uuid())
  orderId             String        @unique @map("order_id")
  reportedBy          String        @map("reported_by") // customerId
  assignedTo          String?       @map("assigned_to") // customerServiceId
  reason              String
  status              DisputeStatus @default(OPEN)
  resolution          String?
  createdAt           DateTime      @default(now()) @map("created_at")
  resolvedAt          DateTime?     @map("resolved_at")

  // Relations
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerService CustomerService? @relation(fields: [assignedTo], references: [id])

  @@map("disputes")
}

model SupportTicket {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  assignedTo  String?               @map("assigned_to") // customerServiceId
  category    SupportTicketCategory
  priority    SupportTicketPriority
  status      SupportTicketStatus   @default(OPEN)
  description String
  /// Set when user requests a human; used to avoid duplicate admin notifications.
  humanEscalationNotifiedAt DateTime? @map("human_escalation_notified_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  resolvedAt  DateTime?             @map("resolved_at")

  // Relations
  user            User             @relation(fields: [userId], references: [id])
  customerService CustomerService? @relation(fields: [assignedTo], references: [id])
  messages        SupportMessage[]

  @@index([status, priority])
  @@index([userId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  senderId   String   @map("sender_id")
  senderType String   @map("sender_type") // 'USER' | 'CUSTOMER_SERVICE' | 'BOT'
  content    String
  image      String?
  /// UI hints: helpfulness buttons, track delivery action, citations, etc.
  metadata   Json?
  timestamp  DateTime @default(now())
  readAt     DateTime? @map("read_at")

  // Relations
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, timestamp])
  @@map("support_messages")
}

// ============================================
// USER RESTRICTIONS
// ============================================

model UserRestriction {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  type      RestrictionType
  reason    String
  imposedBy String          @map("imposed_by") // adminId or 'system'
  startDate DateTime        @default(now()) @map("start_date")
  endDate   DateTime?       @map("end_date") // nullable = permanent
  createdAt DateTime        @default(now()) @map("created_at")
  liftedAt  DateTime?       @map("lifted_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, liftedAt])
  @@map("user_restrictions")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id                  String                     @id @default(uuid())
  userId              String                     @map("user_id")
  userType            String                     @map("user_type") 
  title               String
  body                String
  type                NotificationType
  priority            NotificationPriority       @default(MEDIUM)
  channels            NotificationChannel[]
  relatedEntityType   String?                    @map("related_entity_type")
  relatedEntityId     String?                    @map("related_entity_id")
  actionButtons       Json?                      @map("action_buttons")
  expiresAt           DateTime?                  @map("expires_at")
  groupKey            String?                    @map("group_key")
  sentAt              DateTime                   @default(now()) @map("sent_at")
  readAt              DateTime?                  @map("read_at")
  deliveryStatus      NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  failureReason       String?                    @map("failure_reason")

  // Relations removed — userId is polymorphic (can be User or SuperUser)
  // Lookups handled in application code based on userType

  @@index([userId, readAt])
  @@index([userId, userType, sentAt])
  @@index([groupKey])
  @@index([type])
  @@map("notifications")
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String
  description String?
  updatedBy   String?  @map("updated_by") // adminId
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ============================================
// AI SUPPORT (ops / audit)
// ============================================

model AiSupportToolLog {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  userId     String   @map("user_id")
  toolName   String   @map("tool_name")
  durationMs Int      @map("duration_ms")
  success    Boolean
  errorCode  String?  @map("error_code")
  model      String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@index([createdAt])
  @@map("ai_support_tool_logs")
}

model AiSupportFeedback {
  id        String   @id @default(uuid())
  messageId String   @unique @map("message_id")
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  helpful   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ai_support_feedback")
}

// ============================================
// ACTION LOGS (AUDIT TRAIL)
// ============================================

model ActionLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorRole  String   @map("actor_role") // 'ADMIN' or 'CUSTOMER_SERVICE'
  actionType String   @map("action_type")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  superUser SuperUser @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("action_logs")
}

// ============================================
// ORDER DRIVER REJECTIONS
// ============================================

model OrderDriverRejection {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  driverId  String   @map("driver_id")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([orderId, driverId])
  @@map("order_driver_rejections")
}

// ============================================
// SECURITY — LOGIN ATTEMPT LOGGING
// ============================================

model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String   // phone, email, or googleId used
  loginType  String   @map("login_type") // CUSTOMER, DRIVER, ADMIN, CUSTOMER_SERVICE, GOOGLE
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  success    Boolean
  failReason String?  @map("fail_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}
