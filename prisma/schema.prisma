model CashTransaction {
  id            String   @id @default(uuid())
  orderId       String   @unique @map("order_id")
  driverId      String   @map("driver_id")
  cashCollected Decimal  @db.Decimal(10, 2) @map("cash_collected")
  platformFee   Decimal  @db.Decimal(10, 2) @map("platform_fee")
  driverNet     Decimal  @db.Decimal(10, 2) @map("driver_net")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id])

  @@map("cash_transactions")
}

// ============================================
// CUSTOMER WALLET
// ============================================

model DigitalWallet {
  id         String  @id @default(uuid())
  customerId String  @unique @map("customer_id")
  balance    Decimal @default(0) @db.Decimal(10, 2)
  /// Coins reserved for outbound P2P transfers in PENDING / until settlement
  lockedForTransfers Decimal @default(0) @map("locked_for_transfers") @db.Decimal(10, 2)
  currency   String  @default("TND")
  countryId  String  @map("country_id")
  discount   Decimal @default(0) @db.Decimal(10, 2)
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  country             Country              @relation(fields: [countryId], references: [id])
  transactions        WalletTransaction[]
  withdrawalRequests  WithdrawalRequest[]

  @@map("digital_wallets")
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String                @map("wallet_id")
  orderId       String?               @map("order_id")
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(10, 2)
  status        TransactionStatus     @default(PENDING)
  referenceId   String?               @map("reference_id") // External payment reference (Stripe, etc.)
  referenceType ReferenceType?        @map("reference_type")
  balanceAfter  Decimal               @db.Decimal(10, 2) @map("balance_after")
  createdAt     DateTime              @default(now()) @map("created_at")

  // Relations
  wallet DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order?        @relation(fields: [orderId], references: [id])

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id                    String           @id @default(uuid())
  walletId              String           @map("wallet_id")
  amount                Decimal          @db.Decimal(10, 2)
  feeAmount             Decimal          @default(0) @map("fee_amount") @db.Decimal(10, 2)
  status                ResponseType     @default(PENDING)
  payoutMethod          FiatPayoutMethod @default(BANK_TRANSFER) @map("payout_method")
  payoutBankHolderName  String?          @map("payout_bank_holder_name")
  payoutBankName        String?          @map("payout_bank_name")
  payoutBankAccountRef  String?          @map("payout_bank_account_ref")
  descriptionOfCustomer String?          @map("description_of_customer")
  descriptionOfAdmin    String?          @map("description_of_admin")
  rejectionReason       String?          @map("rejection_reason")
  requestedAt           DateTime         @default(now()) @map("requested_at")
  processedAt           DateTime?        @map("processed_at")

  // Relations
  wallet DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("withdrawal_requests")
}

// ============================================
// COIN P2P & CONFIG
// ============================================

model CountryCoinConfig {
  id              String    @id @default(uuid())
  countryId       String    @map("country_id")
  /// Platform fee on P2P transfers in basis points (e.g. 200 = 2%)
  transferFeeBps  Int       @default(200) @map("transfer_fee_bps")
  /// Wallet coins credited per 1.00 unit of this country’s fiat when converting cash (e.g. COD) to coins
  coinsPerFiatUnit Decimal  @default(1) @map("coins_per_fiat_unit") @db.Decimal(12, 4)
  /// Platform fee on fiat withdrawal requests in basis points (e.g. 250 = 2.5% of payout amount)
  withdrawalFeeBps Int      @default(0) @map("withdrawal_fee_bps")
  effectiveFrom   DateTime  @default(now()) @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  isActive        Boolean   @default(true) @map("is_active")
  promoLabel      String?   @map("promo_label")
  createdAt       DateTime  @default(now()) @map("created_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId, isActive, effectiveFrom])
  @@map("country_coin_configs")
}

model CoinTopupSession {
  id                  String                @id @default(uuid())
  userId              String                @map("user_id")
  payerRole           CoinTopupPayerRole    @map("payer_role")
  countryId           String                @map("country_id")
  coinsAmount         Decimal               @map("coins_amount") @db.Decimal(12, 4)
  fiatAmount          Decimal               @map("fiat_amount") @db.Decimal(14, 6)
  fiatCurrencyCode    String                @map("fiat_currency_code")
  amountMillimes      Int                   @map("amount_millimes")
  coinsPerFiatUnit    Decimal               @map("coins_per_fiat_unit") @db.Decimal(12, 4)
  developerTrackingId String                @unique @map("developer_tracking_id")
  flouciPaymentId     String?               @unique @map("flouci_payment_id")
  checkoutUrl         String?               @map("checkout_url")
  status              CoinTopupSessionStatus @default(PENDING)
  createdAt           DateTime              @default(now()) @map("created_at")
  completedAt         DateTime?             @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("coin_topup_sessions")
}

model UserTransferPin {
  userId         String    @id @map("user_id")
  pinHash        String    @map("pin_hash")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_transfer_pins")
}

model TransferStepUpChallenge {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("transfer_step_up_challenges")
}

model CoinTransfer {
  id                 String             @id @default(uuid())
  senderUserId       String             @map("sender_user_id")
  recipientUserId    String             @map("recipient_user_id")
  grossCoins         Decimal            @map("gross_coins") @db.Decimal(12, 2)
  feeCoins           Decimal            @map("fee_coins") @db.Decimal(12, 2)
  netCoins           Decimal            @map("net_coins") @db.Decimal(12, 2)
  feeBps             Int                @map("fee_bps")
  status             CoinTransferStatus @default(PENDING)
  giftMessage        String?            @map("gift_message") @db.VarChar(500)
  scheduledAt        DateTime?          @map("scheduled_at")
  pendingUntil       DateTime?          @map("pending_until")
  idempotencyKey     String?            @unique @map("idempotency_key")
  senderCountryId    String             @map("sender_country_id")
  recipientCountryId String             @map("recipient_country_id")
  clientIp           String?            @map("client_ip") @db.VarChar(64)
  deviceId           String?            @map("device_id") @db.VarChar(128)
  completedAt        DateTime?          @map("completed_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  failedReason       String?            @map("failed_reason") @db.VarChar(500)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  sender    User @relation("CoinTransferSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient User @relation("CoinTransferRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  reports   CoinTransferReport[]

  @@index([senderUserId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([status, pendingUntil])
  @@index([status, scheduledAt])
  @@map("coin_transfers")
}

model CoinTransferReport {
  id             String   @id @default(uuid())
  transferId     String   @map("transfer_id")
  reporterUserId String   @map("reporter_user_id")
  note           String?  @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at")

  transfer CoinTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([reporterUserId, createdAt])
  @@map("coin_transfer_reports")
}

// ============================================
// REFERRAL SYSTEM
// ============================================

model ReferralCode {
  id                  String             @id @default(uuid())
  code                String             @unique
  type                ReferralCodeType
  value               Decimal            @db.Decimal(10, 2)
  maxDiscountAmount   Decimal?           @db.Decimal(10, 2) @map("max_discount_amount")
  minOrderAmount      Decimal?           @db.Decimal(10, 2) @map("min_order_amount")
  usageLimit          Int?               @map("usage_limit")
  usagePerUserLimit   Int?               @map("usage_per_user_limit")
  validFrom           DateTime?          @map("valid_from")
  validUntil          DateTime?          @map("valid_until")
  active              Boolean            @default(true)
  createdBy           String?            @map("created_by") // adminId or 'system'
  ownerId             String?            @unique @map("owner_id") // customerId (nullable for admin codes)
  totalUses           Int                @default(0) @map("total_uses")

  // Relations
  owner               Customer?            @relation("CustomerOwnedCode", fields: [ownerId], references: [id])
  usersReferred       Customer[]           @relation("CustomerReferredBy")
  commissions         ReferralCommission[]

  @@map("referral_codes")
}

model ReferralCommission {
  id                  String                   @id @default(uuid())
  referralCodeId      String                   @map("referral_code_id")
  referrerCustomerId  String                   @map("referrer_customer_id")
  referredCustomerId  String                   @map("referred_customer_id")
  orderId             String                   @map("order_id")
  commissionAmount    Decimal                  @db.Decimal(10, 2) @map("commission_amount")
  status              ReferralCommissionStatus @default(PAID)
  createdAt           DateTime                 @default(now()) @map("created_at")

  // Relations
  referralCode       ReferralCode @relation(fields: [referralCodeId], references: [id])
  referrerCustomer   Customer     @relation("ReferrerCommissions", fields: [referrerCustomerId], references: [id])
  referredCustomer   Customer     @relation("ReferredCommissions", fields: [referredCustomerId], references: [id])
  order              Order        @relation(fields: [orderId], references: [id])

  @@map("referral_commissions")
}

// ============================================
// RATINGS & REVIEWS
// ============================================

model Rating {
  id         String   @id @default(uuid())
  orderId    String   @unique @map("order_id")
  customerId String   @map("customer_id")
  driverId   String   @map("driver_id")
  score      Int      @db.SmallInt // 0-10
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation("CustomerRatings", fields: [customerId], references: [id])
  driver   Driver   @relation("DriverRatings", fields: [driverId], references: [id])

  @@index([driverId, score])
  @@map("ratings")
}

// ============================================
// CHAT SYSTEM
// ============================================

model ChatRoom {
  id         String     @id @default(uuid())
  orderId    String     @map("order_id")
  customerId String     @map("customer_id")
  driverId   String     @map("driver_id")
  status     ChatStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at")

  // Relations
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id])
  driver   Driver    @relation(fields: [driverId], references: [id])
  messages Message[]

  @@index([orderId, status, createdAt])
  @@map("chat_rooms")
}

model Message {
  id         String            @id @default(uuid())
  chatRoomId String            @map("chat_room_id")
  senderId   String            @map("sender_id")
  senderType MessageSenderType @map("sender_type")
  content    String
  image      String?
  timestamp  DateTime          @default(now())
  readAt     DateTime?         @map("read_at")

  // Relations
  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id])

  @@index([chatRoomId, timestamp])
  @@map("messages")
}

// ============================================
// GPS TRACKING
// ============================================

model DriverLocation {
  id        String   @id @default(uuid())
  driverId  String   @map("driver_id")
  orderId   String?  @map("order_id") // Nullable: only set when actively delivering
  latitude  Float
  longitude Float
  accuracy  Float?   // in meters
  timestamp DateTime @default(now())

  // Relations
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([driverId, timestamp])
  @@index([orderId, timestamp])
  @@map("driver_locations")
}

// ============================================
// DISPUTES & SUPPORT
// ============================================

model Dispute {
  id                  String        @id @default(uuid())
  orderId             String        @unique @map("order_id")
  reportedBy          String        @map("reported_by") // customerId
  assignedTo          String?       @map("assigned_to") // customerServiceId
  reason              String
  status              DisputeStatus @default(OPEN)
  resolution          String?
  createdAt           DateTime      @default(now()) @map("created_at")
  resolvedAt          DateTime?     @map("resolved_at")

  // Relations
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerService CustomerService? @relation(fields: [assignedTo], references: [id])

  @@map("disputes")
}

model SupportTicket {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  assignedTo  String?               @map("assigned_to") // customerServiceId
  category    SupportTicketCategory
  priority    SupportTicketPriority
  status      SupportTicketStatus   @default(OPEN)
  description String
  /// Set when user requests a human; used to avoid duplicate admin notifications.
  humanEscalationNotifiedAt DateTime? @map("human_escalation_notified_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  resolvedAt  DateTime?             @map("resolved_at")

  // Relations
  user            User             @relation(fields: [userId], references: [id])
  customerService CustomerService? @relation(fields: [assignedTo], references: [id])
  messages        SupportMessage[]

  @@index([status, priority])
  @@index([userId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  senderId   String   @map("sender_id")
  senderType String   @map("sender_type") // 'USER' | 'CUSTOMER_SERVICE' | 'BOT'
  content    String
  image      String?
  /// UI hints: helpfulness buttons, track delivery action, citations, etc.
  metadata   Json?
  timestamp  DateTime @default(now())
  readAt     DateTime? @map("read_at")

  // Relations
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, timestamp])
  @@map("support_messages")
}

// ============================================
// USER RESTRICTIONS
// ============================================

model UserRestriction {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  type      RestrictionType
  reason    String
  imposedBy String          @map("imposed_by") // adminId or 'system'
  startDate DateTime        @default(now()) @map("start_date")
  endDate   DateTime?       @map("end_date") // nullable = permanent
  createdAt DateTime        @default(now()) @map("created_at")
  liftedAt  DateTime?       @map("lifted_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, liftedAt])
  @@map("user_restrictions")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id                  String                     @id @default(uuid())
  userId              String                     @map("user_id")
  userType            String                     @map("user_type") 
  title               String
  body                String
  type                NotificationType
  priority            NotificationPriority       @default(MEDIUM)
  channels            NotificationChannel[]
  relatedEntityType   String?                    @map("related_entity_type")
  relatedEntityId     String?                    @map("related_entity_id")
  actionButtons       Json?                      @map("action_buttons")
  expiresAt           DateTime?                  @map("expires_at")
  groupKey            String?                    @map("group_key")
  sentAt              DateTime                   @default(now()) @map("sent_at")
  readAt              DateTime?                  @map("read_at")
  deliveryStatus      NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  failureReason       String?                    @map("failure_reason")
  /// Mobile inbox / preview: e.g. `{ "suppressDriverOrderNavigation": true }` when driver must not open order detail.
  notificationMetadata Json?                   @map("notification_metadata")

  // Relations removed — userId is polymorphic (can be User or SuperUser)
  // Lookups handled in application code based on userType

  @@index([userId, readAt])
  @@index([userId, userType, sentAt])
  @@index([groupKey])
  @@index([type])
  @@map("notifications")
}

// ============================================
// GAMES (QUIZ & FUTURE TYPES)
// ============================================

enum GameType {
  QUIZ
}

enum GameScheduleMode {
  ALL_DAYS
  CALENDAR_DAYS
  WEEKDAYS
}

enum GamePeriodMode {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum GameCustomPeriodAnchor {
  ROLLING
  FIXED_BLOCKS
}

enum GameWinnerSelectionMode {
  RANDOM
  MANUAL
  RANDOM_CONFIRM
}

enum GamePrizeType {
  COINS
  PHYSICAL
}

enum GameCoinCreditMode {
  AUTO_ON_CONFIRM
  MANUAL
}

enum GameWinnerPoolMode {
  COMBINED
  SEPARATE_BY_ROLE
}

enum GameButtonPlacement {
  CUSTOMER_HOME
  CUSTOMER_WALLET
  CUSTOMER_ORDERS
  CUSTOMER_PROFILE
  CUSTOMER_SETTINGS
  CUSTOMER_SUPPORT
  DRIVER_HOME
  DRIVER_EARNINGS
  DRIVER_TRANSACTIONS
  DRIVER_PROFILE
  DRIVER_SETTINGS
  DRIVER_SUPPORT
  DRIVER_MY_ORDERS
}

enum GameDrawStatus {
  OPEN
  AWAITING_CONFIRM
  CONFIRMED
  CANCELLED
}

enum GameWinnerStatus {
  PENDING_CONFIRM
  CONFIRMED
  PRIZE_CREDITED
  REJECTED
}

enum GamePhysicalPrizeStatus {
  PENDING_CONTACT
  CLAIMED
}

model Game {
  id                     String                  @id @default(uuid())
  type                   GameType                @default(QUIZ)
  name                   String
  description            String?                 @db.Text
  isActive               Boolean                 @default(false) @map("is_active")
  scheduleMode           GameScheduleMode        @default(ALL_DAYS) @map("schedule_mode")
  /// Days of month (1–31) when scheduleMode = CALENDAR_DAYS
  calendarDays           Int[]                   @default([]) @map("calendar_days")
  /// 0=Sunday … 6=Saturday when scheduleMode = WEEKDAYS
  weekdays               Int[]                   @default([]) @map("weekdays")
  periodMode             GamePeriodMode          @default(DAILY) @map("period_mode")
  customPeriodDays       Int?                    @map("custom_period_days")
  customPeriodAnchor     GameCustomPeriodAnchor? @map("custom_period_anchor")
  questionsPerDay        Int                     @default(5) @map("questions_per_day")
  accessCodeHash         String                  @map("access_code_hash")
  /// Plain 6-digit code, kept so admins can view the current code at any time. Admin-only access.
  accessCodePlain        String?                 @map("access_code_plain")
  /// Previous plain code, kept so admins can still see the prior code after rotation.
  previousAccessCodePlain String?                @map("previous_access_code_plain")
  accessCodeVersion      Int                     @default(1) @map("access_code_version")
  requireCompletedOrder  Boolean                 @default(false) @map("require_completed_order")
  winnerSelectionMode    GameWinnerSelectionMode @default(RANDOM) @map("winner_selection_mode")
  coinCreditMode         GameCoinCreditMode      @default(AUTO_ON_CONFIRM) @map("coin_credit_mode")
  winnerPoolMode         GameWinnerPoolMode      @default(COMBINED) @map("winner_pool_mode")
  customerButtonPlacement GameButtonPlacement    @map("customer_button_placement")
  driverButtonPlacement   GameButtonPlacement    @map("driver_button_placement")
  /// Gallery images shown on game landing (URLs)
  bannerImageUrls        String[]                @default([]) @map("banner_image_urls")
  showRecentWinners      Boolean                 @default(true) @map("show_recent_winners")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  countries   GameCountry[]
  prizeTiers  GamePrizeTier[]
  categories  GameCategory[]
  questions   GameQuestion[]
  accessGrants GameAccess[]
  codeAttempts GameCodeAttempt[]
  answers     GameAnswer[]
  dailyShown  GameDailyQuestionShown[]
  draws       GameDraw[]
  winners     GameWinner[]

  @@map("games")
}

model GameCountry {
  id        String @id @default(uuid())
  gameId    String @map("game_id")
  countryId String @map("country_id")

  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([gameId, countryId])
  @@map("game_countries")
}

model GamePrizeTier {
  id              String          @id @default(uuid())
  gameId          String          @map("game_id")
  rank            Int
  prizeType       GamePrizeType   @map("prize_type")
  coinAmount      Decimal?        @map("coin_amount") @db.Decimal(10, 2)
  prizeLabel      String?         @map("prize_label")
  prizeImageUrl   String?         @map("prize_image_url")
  congratsImageUrl String?        @map("congrats_image_url")

  game    Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  winners GameWinner[]

  @@unique([gameId, rank])
  @@map("game_prize_tiers")
}

model GameCategory {
  id        String   @id @default(uuid())
  gameId    String   @map("game_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  game      Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questions GameQuestion[]

  @@map("game_categories")
}

model GameQuestion {
  id         String   @id @default(uuid())
  gameId     String   @map("game_id")
  categoryId String   @map("category_id")
  text       String?  @db.Text
  imageUrl   String?  @map("image_url")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  game     Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category GameCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options  GameQuestionOption[]
  answers  GameAnswer[]
  dailyShown GameDailyQuestionShown[]

  @@index([gameId, isActive])
  @@map("game_questions")
}

model GameQuestionOption {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  text       String?
  imageUrl   String? @map("image_url")
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @default(0) @map("sort_order")

  question GameQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  GameAnswer[]

  @@map("game_question_options")
}

model GameAccess {
  id                  String   @id @default(uuid())
  gameId              String   @map("game_id")
  userId              String   @map("user_id")
  accessCodeVersion   Int      @map("access_code_version")
  unlockedAt          DateTime @default(now()) @map("unlocked_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
  @@map("game_access")
}

model GameCodeAttempt {
  id           String    @id @default(uuid())
  gameId       String    @map("game_id")
  userId       String    @map("user_id")
  failedAttempts Int     @default(0) @map("failed_attempts")
  lockedUntil  DateTime? @map("locked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@map("game_code_attempts")
}

model GameAnswer {
  id               String   @id @default(uuid())
  gameId           String   @map("game_id")
  userId           String   @map("user_id")
  questionId       String   @map("question_id")
  selectedOptionId String   @map("selected_option_id")
  isCorrect        Boolean  @map("is_correct")
  tunisiaDateKey   String   @map("tunisia_date_key")
  answeredAt       DateTime @default(now()) @map("answered_at")

  game           Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question       GameQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption GameQuestionOption @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@index([gameId, userId, tunisiaDateKey])
  @@index([gameId, userId, answeredAt])
  @@map("game_answers")
}

model GameDailyQuestionShown {
  id             String @id @default(uuid())
  gameId         String @map("game_id")
  userId         String @map("user_id")
  questionId     String @map("question_id")
  tunisiaDateKey String @map("tunisia_date_key")

  game     Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question GameQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId, questionId, tunisiaDateKey])
  @@map("game_daily_question_shown")
}

model GameDraw {
  id              String         @id @default(uuid())
  gameId          String         @map("game_id")
  periodStart     DateTime       @map("period_start")
  periodEnd         DateTime       @map("period_end")
  status          GameDrawStatus @default(OPEN)
  /// COMBINED | CUSTOMER | DRIVER when winnerPoolMode = SEPARATE_BY_ROLE
  poolScope       String         @default("COMBINED") @map("pool_scope")
  confirmDeadline DateTime?      @map("confirm_deadline")
  createdAt       DateTime       @default(now()) @map("created_at")
  closedAt        DateTime?      @map("closed_at")

  game    Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  winners GameWinner[]

  @@index([gameId, periodEnd])
  @@map("game_draws")
}

model GameWinner {
  id                    String                   @id @default(uuid())
  gameId                String                   @map("game_id")
  drawId                String                   @map("draw_id")
  userId                String                   @map("user_id")
  userRole              UserRole                 @map("user_role")
  prizeTierId           String                   @map("prize_tier_id")
  status                GameWinnerStatus         @default(PENDING_CONFIRM)
  physicalPrizeStatus   GamePhysicalPrizeStatus? @map("physical_prize_status")
  correctCountInPeriod  Int                      @default(0) @map("correct_count_in_period")
  congratsShownAt       DateTime?                @map("congrats_shown_at")
  wonAt                 DateTime                 @default(now()) @map("won_at")
  confirmedAt           DateTime?                @map("confirmed_at")
  creditedAt            DateTime?                @map("credited_at")

  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  draw      GameDraw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  prizeTier GamePrizeTier @relation(fields: [prizeTierId], references: [id], onDelete: Cascade)

  @@index([gameId, userId])
  @@index([drawId])
  @@map("game_winners")
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String
  description String?
  updatedBy   String?  @map("updated_by") // adminId
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ============================================
// AI SUPPORT (ops / audit)
// ============================================

model AiSupportToolLog {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  userId     String   @map("user_id")
  toolName   String   @map("tool_name")
  durationMs Int      @map("duration_ms")
  success    Boolean
  errorCode  String?  @map("error_code")
  model      String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@index([createdAt])
  @@map("ai_support_tool_logs")
}

model AiSupportFeedback {
  id        String   @id @default(uuid())
  messageId String   @unique @map("message_id")
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  helpful   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ai_support_feedback")
}

// ============================================
// ACTION LOGS (AUDIT TRAIL)
// ============================================

model ActionLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorRole  String   @map("actor_role") // 'ADMIN' or 'CUSTOMER_SERVICE'
  actionType String   @map("action_type")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  superUser SuperUser @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("action_logs")
}

// ============================================
// ORDER DRIVER REJECTIONS
// ============================================

model OrderDriverRejection {
  id                String    @id @default(uuid())
  orderId           String    @map("order_id")
  driverId          String    @map("driver_id")
  reason            String?
  driverResponse    String?   @map("driver_response")
  driverRespondedAt DateTime? @map("driver_responded_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([orderId, driverId])
  @@map("order_driver_rejections")
}

// ============================================
// SECURITY — LOGIN ATTEMPT LOGGING
// ============================================

model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String   // phone, email, or googleId used
  loginType  String   @map("login_type") // CUSTOMER, DRIVER, ADMIN, CUSTOMER_SERVICE, GOOGLE
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  success    Boolean
  failReason String?  @map("fail_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}
